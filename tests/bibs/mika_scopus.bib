@ARTICLE{Li202514079,
	author = {Li, Junhao and Huusko, Eetu and Ahooie, Nazanin Nakhaie and Kuutila, Miikka and Huotala, Aleksi and Mäntylä, Mika and Hosio, Simo},
	title = {Credtwi: Investigating Social Media Credibility with a Browser Plugin},
	year = {2025},
	journal = {International Journal of Human-Computer Interaction},
	volume = {41},
	number = {22},
	pages = {14079 – 14095},
	doi = {10.1080/10447318.2025.2480885},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002614549&doi=10.1080%2f10447318.2025.2480885&partnerID=40&md5=2ca0258338a8c61ac25d95dd4e59a7bc},
	affiliations = {Faculty of Information Technology and Electrical Engineering (ITEE), Center for Ubiquitous Computing, University of Oulu, Oulu, Finland; Faculty of Computer Science, Dalhousie University, Halifax, Canada; Department of Computer Science, Faculty of Science, University of Helsinki, Helsinki, Finland; Faculty of Information Technology and Electrical Engineering (ITEE), The Empirical Software Engineering in Software, Systems and Services (M3S) Research Unit, University of Oulu, Oulu, Finland},
	abstract = {People now look for information online and on social media for everyday problems. Organizations and malevolent actors have taken the opportunity to spread misinformation/disinformation. It is increasingly important to understand the credibility of online information. We designed and implemented a research browser plugin, Credtwi. It injects credibility questionnaires directly into the user’s Twitter feed, enabling crowdsourced data collection. We carried out a week-long field study where participants assessed the credibility of tweets on various topics. We provide insights into information credibility in the Twitter ecosystem by analyzing the assessments and study questionnaires. The participants’ perception of Twitter as a credible information source decreased after using Credtwi. Our results suggest that the author’s verification status and bio are the most important factors for their perceived credibility. Finally, we discovered significant differences between the assessments of the different genders. Our results contribute to the research on online social media content credibility. © 2025 The Author(s). Published with license by Taylor & Francis Group, LLC.},
	author_keywords = {browser plugin; credibility; crowdsourcing; Human-computer interaction; social media},
	keywords = {Browser plugin; Computer interaction; Credibility; Data collection; Field studies; Information credibilities; Information sources; Online information; Plug-ins; Social media; Tweets},
	correspondence_address = {J. Li; Faculty of Information Technology and Electrical Engineering (ITEE), Center for Ubiquitous Computing, University of Oulu, Oulu, Finland; email: junhao.li@oulu.fi},
	publisher = {Taylor and Francis Ltd.},
	issn = {10447318},
	language = {English},
	abbrev_source_title = {Int. J. Hum.-Comput. Interact.},
	type = {Article},
