	source = {Scopus},
	note = {Cited by: 28; Conference name: 8th ACM/IEEE International Symposium on Empirical Software Engineering and Measurement, ESEM 2014; Conference date: 18 September 2014 through 19 September 2014; Conference code: 107361; All Open Access, Green Open Access}
}

@CONFERENCE{Kupiainen201423,
	author = {Kupiainen, Eetu and Mäntylä, Mika V. and Itkonen, Juha},
	title = {Why are industrial agile teams using metrics and how do they use them?},
	year = {2014},
	journal = {5th International Workshop on Emerging Trends in Software Metrics, WETSoM 2014 - Proceedings},
	pages = {23 – 29},
	doi = {10.1145/2593868.2593873},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84974597136&doi=10.1145%2f2593868.2593873&partnerID=40&md5=0eb9ce0ec714e2e5f7b97ca45ae61636},
	affiliations = {Department of Computer Science and Engineering, Aalto University, Aalto, FI-00076, Finland},
	abstract = {Agile development methods are increasing in popularity, yet there are limited studies on the reasons and use of metrics in industrial agile development. This paper presents preliminary results from a systematic literature review. Based on our study, metrics and their use are focused to the following areas : Iteration Planning, Iteration Tracking, Motivating and Improving, Identifying Process Problems, Pre-release Quality, Post-release Quality and Changes in Processes or Tools. The findings are mapped against agile principles and it seems that the use of metrics supports the principles with some deviations. Surprisingly, we find little evidence of the use of code metrics. Also, we note that there is a lot of evidence on the use of planning and tracking metrics. Finally, the use of metrics to motivate and enforce process improvements as well as applicable quality metrics can be interesting future research topics. Copyright 2014 ACM.},
	author_keywords = {Agile software development; Measurement; Metrics},
	keywords = {Iterative methods; Measurements; Software design; Agile development; Agile development methods; Agile software development; Iteration planning; Metrics; Process Improvement; Research topics; Systematic literature review; Software engineering},
