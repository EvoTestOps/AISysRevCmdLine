	keywords = {Logistic regression; Natural language processing systems; Pipeline codes; Software packages; Character n-gram; Glmnet; Language processing; Lasso; Logistics regressions; Machine-learning; N-grams; Natural language processing; Natural languages; Preprocessing; Regular expressions; Text mining},
