@CONFERENCE{Kuutila2018,
	author = {Kuutila, Miikka and Mäntylä, Mika V. and Claes, Maëlick and Elovainio, Marko and Adams, Bram},
	title = {Using experience sampling to link software repositories with emotions and work well-being},
	year = {2018},
