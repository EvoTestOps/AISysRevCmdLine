	keywords = {Application programs; Behavioral research; Data acquisition; Fusion reactions; Interactive computer systems; Learning systems; Modal analysis; Anomaly detection; Dataset; Fusion methods; Log; Metric; Microservice system; Multi-modal fusion; Multi-modal fusion method; Oauth2.0; Trace; Anomaly detection},
