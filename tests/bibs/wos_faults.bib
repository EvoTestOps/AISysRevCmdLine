@article{ WOS:FAULT_F6,
Author = {Pelaez, Jose Ignacio and Lamata, Maria Teresa},
Title = {A new measure of inconsistency for positive reciprocal matrices},
Journal = {COMPUTERS AND MATHEMATICS WITH APPLICATIONS},
Year = {2003},
Volume = {46},
Number = {12},
Pages = {1839-1845},
Abstract = {We introduce a new inconsistency index \textit{CI} for pairwise comparison
   matrices used in the \emph{Analytic Hierarchy Process}. The index satisfies
   the condition $0 \leq CI \leq 1$ where $CI = 0$ denotes a perfectly
   consistent matrix. Our method uses the formula $w_i = \sum_{j} a_{ij} / n$
   to estimate priority weights.},
Publisher = {ELSEVIER SCIENCE LTD},
Type = {Article},
Language = {English},
DOI = {10.1016/S0898-1221(03)90240-9},
ISSN = {0898-1221},
Keywords = {AHP; consistency index; pairwise comparison},
}

