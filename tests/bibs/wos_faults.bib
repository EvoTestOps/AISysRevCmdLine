
@article{ WOS:FAULT_BASELINE,
Author = {Mazurek, Jiri and Strzalka, Dominik},
Title = {On the Monte Carlo weights in multiple criteria decision analysis},
Journal = {PLOS ONE},
Year = {2022},
Volume = {17},
Number = {10},
Pages = {e0268950},
Month = {OCT 7},
Abstract = {In multiple-criteria decision making weights of criteria constitute a
   crucial input for finding an optimal solution. A large number of methods
   were proposed for criteria weights derivation including direct ranking,
   point allocation, and pairwise comparisons. The aim of this paper is to
   approach the problem of determining criteria weights from a different
   perspective.},
Publisher = {PUBLIC LIBRARY SCIENCE},
Type = {Article},
Language = {English},
DOI = {10.1371/journal.pone.0268950},
ISSN = {1932-6203},
Keywords = {Decision Making; Monte Carlo Method; Criteria weights},
}

