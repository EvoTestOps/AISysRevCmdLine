@inproceedings{ WOS:000469272600269,
Author = {Luo, Chu and Kuutila, Miikka and Klakegg, Simon and Ferreira, Denzil and
   Flores, Huber and Goncalves, Jorge and Kostakos, Vassilis and Mantyla,
   Mika},
Book-Group-Author = {Assoc Comp Machinery},
Title = {How to Validate Mobile Crowdsourcing Design? Leveraging Data Integration
   in Prototype Testing},
Booktitle = {UBICOMP'16 ADJUNCT: PROCEEDINGS OF THE 2016 ACM INTERNATIONAL JOINT
   CONFERENCE ON PERVASIVE AND UBIQUITOUS COMPUTING},
Year = {2016},
Pages = {1448-1453},
Note = {ACM International Joint Conference on Pervasive and Ubiquitous Computing
   (UbiComp) / 20th ACM International Symposium on Wearable Computers
   (ISWC), Heidelberg, GERMANY, SEP 12-16, 2016},
Organization = {Assoc Comp Machinery; ACM SIGCHI; ACM SIGMOBILE},
Abstract = {Mobile crowdsourcing applications often run in dynamic environments. Due
   to limited time and budget, developers of mobile crowdsourcing
   applications sometimes cannot completely test their prototypes in real
   world situations. We describe a data integration technique for
   developers to validate their design in prototype testing. Our approach
   constructs the intended context by combining real-time, historical and
   simulated data. With correct context-aware design, mobile crowdsourcing
   applications presenting crowdsourcing questions in relevant context to
   users are likely to obtain high response quality.},
