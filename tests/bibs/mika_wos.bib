@inproceedings{ WOS:001017777500050,
Author = {Claes, Maelick and Mantyla, Mika V.},
Book-Group-Author = {IEEE},
Title = {20-MAD-20 Years of Issues and Commits of Mozilla and Apache Development},
Booktitle = {2020 IEEE/ACM 17TH INTERNATIONAL CONFERENCE ON MINING SOFTWARE
   REPOSITORIES, MSR},
Series = {IEEE International Working Conference on Mining Software Repositories},
