@inproceedings{ WOS:000611527400002,
Author = {Raulamo-Jurvanen, Paivi and Hosio, Simo and Mantyla, V, Mika},
Editor = {Franch, X and Mannisto, T and MartinezFernandez, S},
Title = {Applying Surveys and Interviews in Software Test Tool Evaluation},
Booktitle = {PRODUCT-FOCUSED SOFTWARE PROCESS IMPROVEMENT, PROFES 2019},
Series = {Lecture Notes in Computer Science},
Year = {2019},
Volume = {11915},
Pages = {20-36},
Note = {20th International Conference on Product-Focused Software Process
   Improvement (PROFES), Univ Politecnica Catalunya BarcelonaTech,
   Barcelona, SPAIN, NOV 27-29, 2019},
Abstract = {Despite the multitude of available software testing tools, literature
   lists lack of right tools and costs as problems for adopting a tool. We
   conducted a case study to analyze how a group of practitioners, familiar
   with Robot Framework (an open source, generic test automation
   framework), evaluate the tool. We based the case and the unit of
   analysis on our academia-industry relations, i.e., availability. We used
   a survey (n = 68) and interviews (n = 6) with convenience sampling to
   develop a comprehensive view of the phenomena. The study reveals the
   importance of understanding the interconnection of different criteria
   and the potency of the context on those. Our results show that
   unconfirmed or unfocused opinions about criteria, e.g., about Costs or
   Programming Skills, can lead to misinterpretations or hamper strategic
   decisions if overlooking required technical competence. We conclude
   surveys can serve as a useful instrument for collecting empirical
   knowledge about tool evaluation, but experiential reasoning collected
   with a complementary method is required to develop into comprehensive
   understanding about it.},
